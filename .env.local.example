# ============================================
# Amélia Saúde - Environment Variables
# ============================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no git!

# --------------------------------------------
# Database (Neon PostgreSQL)
# --------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require

# --------------------------------------------
# Auth (JWT)
# --------------------------------------------
# Gere um segredo forte: openssl rand -base64 32
JWT_SECRET=seu-jwt-secret-aqui-mude-para-producao

# --------------------------------------------
# OpenRouter API (AI Chat)
# --------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# --------------------------------------------
# WhatsApp Evolution API
# --------------------------------------------
EVOLUTION_API_URL=https://sua-instancia.railway.app
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE_NAME=ameliasaudeoficial

# --------------------------------------------
# Cron Job Secret
# --------------------------------------------
CRON_SECRET=seu-cron-secret-aqui
